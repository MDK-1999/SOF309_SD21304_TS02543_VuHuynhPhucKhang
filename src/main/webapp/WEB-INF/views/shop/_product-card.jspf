<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:url var="fallbackImage" value="/product-image"><c:param name="id" value="${p.productId}" /></c:url>
<article class="product-card">
  <a class="product-media" href="${pageContext.request.contextPath}/product?id=${p.productId}"
     aria-label="Xem ${fn:escapeXml(p.productName)}">
    <img src="${fallbackImage}" alt="${fn:escapeXml(p.productName)}"
         loading="${productCardEager ? 'eager' : 'lazy'}"
         fetchpriority="${productCardEager ? 'high' : 'auto'}"
         decoding="async" width="640" height="512" />
    <div class="product-media-badges">
      <span class="official-chip">Chính hãng</span>
      <c:if test="${p.stockQty > 0 && p.stockQty <= 5}"><span class="low-stock-chip">Chỉ còn ${p.stockQty}</span></c:if>
    </div>
    <span class="product-category"><c:out value="${p.catName}" /></span>
  </a>
  <div class="product-card-body">
    <div class="product-meta"><span><c:out value="${p.brand}" /></span><span title="${fn:escapeXml(p.model)}"><c:out value="${p.model}" /></span></div>
    <a class="product-name" href="${pageContext.request.contextPath}/product?id=${p.productId}"><c:out value="${p.productName}" /></a>
    <div class="product-specs"><c:out value="${p.specs}" /></div>
    <div class="product-commerce"><div><span class="product-price-label">Giá bán</span><div class="product-price"><fmt:formatNumber value="${p.price}" type="number" groupingUsed="true" />đ</div></div>
      <div class="product-stock ${p.stockQty == 0 ? 'out' : ''}"><span></span><c:out value="${p.stockStatus}" /><c:if test="${p.stockQty > 0}"> &middot; Kho ${p.stockQty}</c:if></div>
    </div>
    <form class="product-actions" action="${pageContext.request.contextPath}/cart" method="post">
      <input type="hidden" name="_csrf" value="${csrfToken}" />
      <input type="hidden" name="productId" value="${p.productId}" />
      <input type="hidden" name="qty" value="1" />
      <a class="btn secondary" href="${pageContext.request.contextPath}/product?id=${p.productId}">Chi tiết</a>
      <button class="btn" type="submit" ${p.stockQty == 0 ? 'disabled' : ''}>${p.stockQty == 0 ? 'Hết hàng' : 'Thêm vào giỏ'}</button>
    </form>
  </div>
</article>
